<?xml version="1.0"?>
<!-- Dimensions from course-kit models/course_ackermann/model.sdf (SI: m, kg, s). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">

  <!-- Geometry parameters (no magic numbers in links/joints). -->
  <xacro:property name="base_length" value="1.05"/>
  <xacro:property name="base_width" value="0.52"/>
  <xacro:property name="base_height" value="0.22"/>
  <xacro:property name="base_visual_z" value="0.12"/>
  <xacro:property name="base_mass" value="12.0"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="track" value="0.62"/>
  <xacro:property name="wheel_base" value="0.8"/>
  <xacro:property name="half_track" value="${track / 2.0}"/>
  <xacro:property name="half_wheel_base" value="${wheel_base / 2.0}"/>

  <!-- Sensor mounts (from SDF link poses relative to base_link). -->
  <xacro:property name="sensor_x" value="0.28"/>
  <xacro:property name="sensor_y" value="0.0"/>
  <xacro:property name="sensor_z" value="0.38"/>
  <xacro:property name="sensor_mass" value="0.033333333333"/>
  <xacro:property name="sensor_ixx" value="0.000333333333"/>
  <xacro:property name="sensor_iyy" value="0.000333333333"/>
  <xacro:property name="sensor_izz" value="0.000333333333"/>

  <!-- Parent of lidar_link: must stay base_link for correct geometry. -->
  <xacro:arg name="lidar_parent" default="base_link"/>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(mass/12.0)*(y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${(mass/12.0)*(x*x + z*z)}" iyz="0.0"
        izz="${(mass/12.0)*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${0.25*mass*radius*radius + (1.0/12.0)*mass*length*length}"
        ixy="0.0" ixz="0.0"
        iyy="${0.25*mass*radius*radius + (1.0/12.0)*mass*length*length}"
        iyz="0.0"
        izz="${0.5*mass*radius*radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel">
      <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.04 0.04 0.04 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <link name="base_link">
    <inertial>
      <mass value="${base_mass}"/>
      <origin xyz="0 0 ${base_visual_z}" rpy="0 0 0"/>
      <inertia ixx="0.55" ixy="0" ixz="0" iyy="1.10" iyz="0" izz="1.40"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${base_visual_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.05 0.36 0.72 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_visual_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <xacro:wheel prefix="front_left" x="${half_wheel_base}" y="${half_track}"/>
  <xacro:wheel prefix="front_right" x="${half_wheel_base}" y="${-half_track}"/>
  <xacro:wheel prefix="rear_left" x="${-half_wheel_base}" y="${half_track}"/>
  <xacro:wheel prefix="rear_right" x="${-half_wheel_base}" y="${-half_track}"/>

  <link name="camera_link">
    <inertial>
      <mass value="${sensor_mass}"/>
      <inertia ixx="${sensor_ixx}" ixy="0" ixz="0" iyy="${sensor_iyy}" iyz="0" izz="${sensor_izz}"/>
    </inertial>
    <visual>
      <geometry><box size="0.06 0.08 0.04"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.06 0.08 0.04"/></geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <mass value="${sensor_mass}"/>
      <inertia ixx="${sensor_ixx}" ixy="0" ixz="0" iyy="${sensor_iyy}" iyz="0" izz="${sensor_izz}"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="$(arg lidar_parent)"/>
    <child link="lidar_link"/>
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="${sensor_mass}"/>
      <inertia ixx="${sensor_ixx}" ixy="0" ixz="0" iyy="${sensor_iyy}" iyz="0" izz="${sensor_izz}"/>
    </inertial>
    <visual>
      <geometry><box size="0.03 0.03 0.02"/></geometry>
      <material name="orange"><color rgba="0.9 0.45 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.03 0.03 0.02"/></geometry>
    </collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0 0 0"/>
  </joint>

</robot>
